# Any endpoint implementing the OpenAI Responses API (POST /responses).
LLM_BASE_URL=https://api.openai.com/v1
# Literal key, or reference a shell variable: LLM_API_KEY=${MY_KEY_VAR}
LLM_API_KEY=
# Model for swap planning; must support JSON output.
LLM_MODEL=gpt-6.1-sol
# Vision-capable model for reading deck photos (defaults to LLM_MODEL).
LLM_VISION_MODEL=
# Classifier for calibrated yes/no checks (scanned cards, synergies, confirmations) via POST /decisions.
LLM_DECISION_MODEL=gpt-6-luna
# Set to false if the endpoint has no Decisions API; LLM_MODEL then answers the yes/no checks.
LLM_DECISIONS=true
# Web research uses the Responses API web_search tool (set to false to skip).
LLM_WEB_SEARCH=true
# Model for web research (defaults to LLM_MODEL).
LLM_SEARCH_MODEL=
PORT=5173
