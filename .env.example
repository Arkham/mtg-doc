# Any endpoint implementing the OpenAI Responses API (POST /responses).
LLM_BASE_URL=https://api.openai.com/v1
# Literal key, or reference a shell variable: LLM_API_KEY=${MY_KEY_VAR}
LLM_API_KEY=
# Model for swap planning; must support JSON output.
# The model your endpoint serves; it does all the work. There's no AI without it.
LLM_MODEL=
# How hard the model thinks, for every task: low, medium or high. Low keeps a run quick.
LLM_REASONING=low
# Optional: sent as `service_tier` with every Responses API request, if your endpoint has tiers.
# LLM_SERVICE_TIER=fast
# Vision-capable model for reading deck photos (defaults to LLM_MODEL, at its default effort).
LLM_VISION_MODEL=
# Classifier for calibrated yes/no checks (scanned cards, synergies, confirmations) via POST /decisions.
# Model for the Decisions API; without one, LLM_MODEL answers the yes/no checks.
LLM_DECISION_MODEL=
# Set to false if the endpoint has no Decisions API; LLM_MODEL then answers the yes/no checks.
LLM_DECISIONS=true
# Web research uses the Responses API web_search tool (set to false to skip).
LLM_WEB_SEARCH=true
# Model for web research, instead of the faster model the app picks for it.
LLM_SEARCH_MODEL=
PORT=5173
