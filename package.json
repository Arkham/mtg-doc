{
  "name": "mtg-doc",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "node --import tsx scripts/dev.ts",
    "build": "node --import tsx scripts/elm.ts --optimize && vite build",
    "start": "NODE_ENV=production tsx src/server/index.ts",
    "postinstall": "elm-tooling install",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write . && elm-format --yes src/web tests",
    "format:check": "prettier --check . && elm-format --validate src/web tests",
    "lint": "oxlint && elm-review",
    "gen:elm": "tsx scripts/gen-elm.ts",
    "test": "tsx --test tests/unit/*.test.ts tests/integration/*.test.ts",
    "test:elm": "elm-test-rs tests/*Test.elm",
    "test:unit": "tsx --test tests/unit/*.test.ts",
    "test:integration": "tsx --test tests/integration/*.test.ts",
    "test:e2e": "playwright test",
    "test:visual": "playwright test -c playwright.visual.config.ts",
    "test:live": "tsx --test tests/live/*.test.ts",
    "fakes:cards": "tsx tests/support/fakes/add-cards.ts",
    "test:coverage": "tsx --test --experimental-test-coverage --test-coverage-include=\"src/server/**\" tests/unit/*.test.ts tests/integration/*.test.ts",
    "build:static": "tsx scripts/build-static.ts",
    "check:decks": "tsx scripts/check-decks.ts",
    "fix:contradictions": "tsx scripts/fix-contradictions.ts",
    "write:guides": "tsx scripts/write-guides.ts",
    "mark:cards": "tsx scripts/mark-card-refs.ts",
    "symbols": "tsx scripts/fetch-symbols.ts && tsx scripts/gen-elm.ts",
    "preview:static": "vite preview --outDir site --port 4173 --host",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm gen:elm --check && pnpm test && pnpm test:elm"
  },
  "dependencies": {
    "express": "^5.3.0",
    "marked": "^18.1.3",
    "multer": "^2.5.0",
    "sharp": "^0.35.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.6.6",
    "elm-review": "^2.13.5",
    "elm-tooling": "^1.21.0",
    "elm-watch": "^1.2.9",
    "esbuild": "0.28.2",
    "oxc-parser": "^0.159.0",
    "oxlint": "^1.91.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp"
    ]
  },
  "packageManager": "pnpm@10.34.5"
}
