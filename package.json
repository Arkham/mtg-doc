{
  "name": "mtg-doc",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --clear-screen=false --ignore 'decks/**' --ignore 'src/**' server/index.ts",
    "build": "vite build",
    "start": "NODE_ENV=production tsx server/index.ts",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "test": "tsx --test test/unit/*.test.ts test/integration/*.test.ts",
    "build:static": "tsx scripts/build-static.ts",
    "preview:static": "vite preview --outDir site --port 4173 --host",
    "test:unit": "tsx --test test/unit/*.test.ts",
    "test:integration": "tsx --test test/integration/*.test.ts",
    "test:e2e": "playwright test",
    "test:record": "FIXTURES=record tsx --test --test-concurrency=1 test/unit/*.test.ts test/integration/*.test.ts && FIXTURES=record playwright test",
    "test:coverage": "tsx --test --experimental-test-coverage --test-coverage-include=\"server/**\" test/unit/*.test.ts test/integration/*.test.ts",
    "lint": "oxlint",
    "format:check": "prettier --check .",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test"
  },
  "dependencies": {
    "express": "^5.3.0",
    "multer": "^2.5.0",
    "sharp": "^0.35.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "oxlint": "^1.91.0",
    "prettier": "^3.9.10",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp"
    ]
  },
  "packageManager": "pnpm@10.34.5"
}
