{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "import", "unicorn", "oxc"],
  "categories": {
    "correctness": "error"
  },
  "rules": {
    "no-unused-vars": "error",
    "typescript/no-explicit-any": "error",
    "eqeqeq": ["error", "smart"],
    "no-unmodified-loop-condition": "off"
  },
  "ignorePatterns": [
    "node_modules",
    "dist",
    "site",
    "decks",
    "test-results",
    "playwright-report",
    ".vite",
    ".direnv",
    "public/elm",
    "elm-stuff"
  ]
}
